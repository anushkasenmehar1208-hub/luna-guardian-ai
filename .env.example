LUNA_ENV=development
LUNA_AUTH_TOKENS={"replace-with-a-long-random-token":"student-1"}
# Alternative single-token configuration (Render generates this automatically):
# LUNA_AUTH_TOKEN=replace-with-a-long-random-token
# LUNA_AUTH_USER_ID=student-1
LUNA_DB_PATH=./luna.db
# DATABASE_URL=postgresql://user:password@host:5432/database
LUNA_RATE_LIMIT_PER_MINUTE=120

# local, bedrock, or openai-compatible
LUNA_AGENT_PROVIDER=local

# Amazon Bedrock (install requirements-aws.txt)
AWS_REGION=us-east-1
LUNA_BEDROCK_MODEL=amazon.nova-lite-v1:0

# OpenAI-compatible provider
LUNA_OPENAI_BASE_URL=https://api.openai.com/v1
LUNA_OPENAI_MODEL=gpt-4.1-mini
LUNA_OPENAI_API_KEY=
